{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch sbot",
      "program": "${workspaceFolder}/packages/backend/sbot/debug/index.js",
      "preLaunchTask": "launch:sbot",
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/packages/backend/sbot/debug/**/*.js",
        "${workspaceFolder}/packages/shared/shared/dist/**/*.js",
        "${workspaceFolder}/packages/backend/scorpio.di/dist/**/*.js",
        "${workspaceFolder}/packages/backend/llm/*/dist/**/*.js",
        "${workspaceFolder}/packages/backend/saver/*/dist/**/*.js",
        "${workspaceFolder}/packages/backend/scorpio.ai/dist/**/*.js",
        "${workspaceFolder}/packages/backend/plugins/plugin.schema/dist/**/*.js",
        "${workspaceFolder}/packages/backend/plugins/agent/*/dist/**/*.js",
        "${workspaceFolder}/packages/backend/plugins/channel/*/dist/**/*.js",
        "${workspaceFolder}/packages/backend/plugins/wiki/*/dist/**/*.js"
      ],
      "env": { "NODE_ENV": "development" },
      "cwd": "${workspaceFolder}/packages/backend/sbot",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Launch sbot Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}",
        "--extensionDevelopmentPath=${workspaceFolder}/packages/apps/sbot-vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/apps/sbot-vscode/dist/**/*.js"
      ],
      "preLaunchTask": "build:vscode-extension"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Launch cli",
      "program": "${workspaceFolder}/packages/apps/sbot-cli/debug/main.js",
      "preLaunchTask": "debug:cli",
      "console": "externalTerminal",
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/packages/apps/sbot-cli/debug/**/*.js",
        "${workspaceFolder}/packages/shared/shared/dist/**/*.js",
        "${workspaceFolder}/packages/shared/shared/esm/**/*.js"
      ],
      "cwd": "${workspaceFolder}/packages/apps/sbot-cli",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Launch app",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}/packages/apps/client"
    },
    {
      "name": "Launch AdminUI",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:1500/webui/",
      "webRoot": "${workspaceFolder}/packages/apps/admin",
      "sourceMapPathOverrides": {
        "webpack:///./*": "${webRoot}/*",
        "/@fs/*": "/*"
      },
      "preLaunchTask": "launch:adminui"
    }
  ]
}
