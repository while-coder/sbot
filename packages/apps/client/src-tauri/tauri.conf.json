{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "SBot",
  "version": "../package.json",
  "identifier": "com.while.sbot",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1501",
    "beforeDevCommand": "pnpm vite dev --port 1501",
    "beforeBuildCommand": "pnpm vite build"
  },
  "app": {
    "windows": [
      {
        "title": "SBot",
        "width": 480,
        "height": 720,
        "minWidth": 360,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "while",
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English", "TradChinese"],
        "displayLanguageSelector": true
      }
    }
  }
}
